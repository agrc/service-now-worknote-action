{
  "name": "@ugrc/service-now-worknote-action",
  "version": "1.0.23",
  "private": true,
  "description": "An action to update ServiceNow business applications with release notes",
  "keywords": [
    "GitHub",
    "Actions",
    "ServiceNow"
  ],
  "homepage": "https://github.com/agrc/service-now-worknote-action#readme",
  "bugs": {
    "url": "https://github.com/agrc/service-now-worknote-action/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agrc/service-now-worknote-action.git"
  },
  "license": "MIT",
  "author": "ugrc-developers@utah.gov",
  "type": "module",
  "scripts": {
    "build": "rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "check": "tsc -b",
    "format": "prettier . --write",
    "lint": "eslint .",
    "test": "vitest --reporter verbose --coverage"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/http-client": "^4.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^25.9.5",
    "@ugrc/eslint-config": "^1.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "rollup": "^4.62.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
